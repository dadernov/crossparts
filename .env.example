# --- HTTP server ---
CP_HOST=0.0.0.0
CP_PORT=8000

# --- Storage ---
CP_DATABASE_URL=sqlite+aiosqlite:///./data/crossparts.db

# --- Access ---
# Comma-separated "key:tenant_name" pairs. Empty => auth disabled (dev mode).
CP_API_KEYS=demo-key:Demo

# --- Crawling ---
CP_SOURCE_TIMEOUT=45
CP_JOB_CONCURRENCY=4
CP_SOURCE_CONCURRENCY=2
CP_CACHE_TTL_HOURS=168
CP_MAX_PRODUCTS_PER_OE=5
# Скрытый круговой поиск: включить true и перезапустить сервис.
CP_CIRCULAR_SEARCH_ENABLED=false
CP_CIRCULAR_SEARCH_MAX_QUERIES=6
CP_CIRCULAR_SEARCH_MAX_QUERIES_PER_SOURCE=2
CP_CIRCULAR_SEARCH_TIMEOUT=20
CP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36

# Прокси для источников, которые блокируют дата-центровые IP (jnbk, mintex).
# Поддерживается http/https/socks5: http://user:pass@host:port
CP_PROXY_URL=
# Через какие источники пускать прокси. Пусто => через все.
# Прокси обычно платный, поэтому доступные каталоги лучше оставить напрямую.
CP_PROXY_SOURCES=jnbk,mintex
# Проходить Cloudflare-challenge реальным браузером (нужен Chromium).
CP_BROWSER_FALLBACK=true

CP_ENABLED_SOURCES=sbparts,brembo,nibkru

# --- Disabled catalogue pilots ---
# Candidate catalogues stay unavailable unless both an immutable local index
# and an exact source/group/tenant rule are configured. Keep empty in production
# until the staged pilot has passed review.
CP_METACO_INDEX_PATH=
CP_PILOT_RULES=
# Example for an isolated pilot account only:
# CP_PILOT_RULES={"metaco":{"groups":["brake_pads","brake_discs"],"tenants":["pilot-account"],"default":true,"ungrouped":false}}
# Use tenant "*" only for an explicitly approved global rollout.
